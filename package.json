{
  "name": "screenshot-exact-match",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "index.js",
  "description": "Amaravati Solar Solutions - Screenshot Exact Match",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "postinstall": "npm --prefix frontend install --include=dev",
    "build": "npm --prefix frontend install --include=dev && npm --prefix frontend run build && node scripts/build-static.js",
    "build:frontend": "npm --prefix frontend run build",
    "start": "node frontend/.output/server/index.mjs",
    "preview": "npm --prefix frontend run preview",
    "lint": "npm --prefix frontend run lint",
    "test": "npm --prefix frontend run test"
  }
}
