<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Serve static files directly from frontend/.output/public if they exist
    RewriteCond %{DOCUMENT_ROOT}/frontend/.output/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ /frontend/.output/public/$1 [L]

    # 2. Never serve backend source code (.js, .json, .ts, etc. in root)
    RewriteCond %{REQUEST_URI} ^/(index|server|app)\.js$ [NC]
    RewriteRule ^(.*)$ http://127.0.0.1:3000/ [P,L]

    # 3. Forward root request directly to local Node server
    RewriteRule ^$ http://127.0.0.1:3000/ [P,L]

    # 4. Forward all other routes to Node server
    RewriteCond %{REQUEST_URI} !^/frontend/\.output/public/
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
</IfModule>

<IfModule mod_proxy.c>
    ProxyRequests Off
    ProxyPreserveHost On
</IfModule>
