# Amaravati Solar Solutions - LiteSpeed / Apache Routing
DirectoryIndex index.php index.html

# Disable directory browsing to prevent 403 Forbidden
Options -Indexes +FollowSymLinks

# Hostinger 404 Fallback - Always route 404 to index.php instead of Hostinger default error page
ErrorDocument 404 /index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. Pass API requests directly to index.php
    RewriteRule ^api/(.*)$ index.php [QSA,L]

    # 2. If the request matches an existing file or directory, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. If pre-rendered HTML exists in frontend/dist, serve directly
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1/index.html -f
    RewriteRule ^(.*)$ frontend/dist/$1/index.html [L]

    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1.html -f
    RewriteRule ^(.*)$ frontend/dist/$1.html [L]

    # 4. If asset exists in frontend/dist, serve directly
    RewriteCond %{DOCUMENT_ROOT}/frontend/dist/$1 -f
    RewriteRule ^(.*)$ frontend/dist/$1 [L]

    # 5. Route all remaining requests to index.php
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Ensure correct MIME types for assets
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType application/javascript .mjs
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType font/woff2 .woff2
</IfModule>
